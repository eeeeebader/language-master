# Server
PORT=8787
NODE_ENV=development
LOG_LEVEL=info

# Postgres (Supabase). Use the pooler URL in production.
DATABASE_URL=postgres://postgres:your-super-secret-and-long-postgres-password@localhost:5432/postgres
# Supabase JWT secret (Settings → API). Access tokens are HS256-signed with it.
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long
SUPABASE_URL=http://localhost:8000
SUPABASE_SERVICE_ROLE_KEY=

# spaCy annotation service (apps/nlp)
NLP_URL=http://localhost:8001

# LLM providers (the active provider/model is chosen in app_settings)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_TOKENS_10=price_...
STRIPE_PRICE_TOKENS_50=price_...
REVENUECAT_WEBHOOK_SECRET=

# Misc
RUN_MIGRATIONS=true
RUN_CRON=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://app.languagemaster.app

# Optional overrides of the admin app_settings (llm.provider / llm.model.*).
# Provider: anthropic | openai | fake (deterministic, no cost; for local dev and CI)
LLM_PROVIDER=
LLM_MODEL_WRITE=
LLM_MODEL_NOTES=
LLM_MODEL_OPENAI=

# Error tracking (Sentry, EU region); inert when empty.
SENTRY_DSN=
