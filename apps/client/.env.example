# Leave empty for local-only mode (no account, no sync). All three are needed for sync.
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8787

# Native apps only: RevenueCat public SDK keys (Project → API keys). Purchases stay disabled without them.
VITE_REVENUECAT_IOS_KEY=
VITE_REVENUECAT_ANDROID_KEY=

# Error tracking (Sentry, EU region) and product analytics (PostHog Cloud EU). Both inert when empty.
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com
