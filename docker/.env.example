# Copy to docker/.env on the server. Never commit docker/.env.
DOMAIN=languagemaster.app
ACME_EMAIL=admin@languagemaster.app
GHCR_OWNER=your-github-user-or-org
IMAGE_TAG=latest

# Admin console and Supabase Studio are only reachable from these CIDRs (comma separated)
ADMIN_ALLOWLIST=203.0.113.10/32,100.64.0.0/10

# API (apps/api) secrets — values live in docker/.env, names documented here
DATABASE_URL=postgres://postgres:CHANGE_ME@db:5432/postgres
SUPABASE_URL=http://kong:8000
SUPABASE_JWT_SECRET=CHANGE_ME
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_SECRET=
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
PACKS_BUCKET=dictionary-packs

# Internal services
NLP_URL=http://nlp:8080
PIPER_URL=http://piper:5000
PIPER_VOICE=es_ES-davefx-medium

# Listmonk (profile v2)
LISTMONK_DB_PASSWORD=CHANGE_ME
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=CHANGE_ME

# Monitoring (docker-compose.monitoring.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
# Postgres datasource for business panels: host on the supabase network (db) or the pooler
GRAFANA_PG_HOST=db
GRAFANA_PG_PORT=5432
GRAFANA_PG_USER=postgres
GRAFANA_PG_DATABASE=postgres
POSTGRES_PASSWORD=
